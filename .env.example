# Take Off Web — environment variable reference
# Copy to .env.local for local development. Never commit .env.local.

# ─── API ────────────────────────────────────────────────────────────────────
# The base URL of the Spring Boot API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional. Upper bound in milliseconds for a server-side read (GET) from the
# API, including at build time. Defaults to 15000. Writes are never bounded.
# API_READ_TIMEOUT_MS=15000

# ─── Authentication ──────────────────────────────────────────────────────────
# Name of the HttpOnly session cookie written by /api/auth/login
SESSION_COOKIE_NAME=takeoff_session

# Secret used for CSRF double-submit token signing (min 32 chars, random)
CSRF_SECRET=replace_with_a_random_32_char_string

# ─── Sentry ──────────────────────────────────────────────────────────────────
# Leave blank in local dev to disable Sentry initialisation entirely.
NEXT_PUBLIC_SENTRY_DSN=

# Required only during `next build` to upload source maps to Sentry.
SENTRY_AUTH_TOKEN=

# Sentry org and project slugs (used by the Sentry webpack plugin at build time)
SENTRY_ORG=take-off
SENTRY_PROJECT=take-off-web

# ─── Storage / Media ─────────────────────────────────────────────────────────
# CDN host for user-uploaded media (Cloudflare R2 public bucket URL or VPS media host)
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.takeoff.tn

# ─── Feature flags ───────────────────────────────────────────────────────────
# Comma-separated list of enabled feature flags (mirrors /v1/me payload for SSR)
# NEXT_PUBLIC_FEATURE_FLAGS=

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development
